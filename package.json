{
  "name": "scry-github-insights",
  "version": "1.0.0",
  "type": "module",
  "description": "Scry - AI-Powered Architectural Intelligence & Repository Audit Engine",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "npm run dev --prefix client",
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix client"
  },
  "keywords": [
    "github",
    "insights",
    "architecture",
    "security-audit",
    "ai-code-analysis",
    "mermaid",
    "gemini"
  ],
  "author": "Scry Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@types/react-dom": "^19.2.4",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.33.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "concurrently": "^9.1.2",
    "typescript": "^7.0.2"
  }
}
